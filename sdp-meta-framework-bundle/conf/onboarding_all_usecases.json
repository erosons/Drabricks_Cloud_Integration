      "source_table": "CUSTOMERS_EU",
      "source_path_dev": "{uc_volume_path}/test_data/uc5_multi_cdc/customers_eu",
      "source_schema_path": "{uc_volume_path}/conf/ddl/customers_eu.ddl"
    },
    "bronze_catalog_dev": "{uc_catalog_name}",
