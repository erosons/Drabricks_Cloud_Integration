# ---------------------------------------------------------------
# Kraken API Credentials
# Get these from: https://www.kraken.com/u/security/api
# Required permissions: Query Funds, Query Orders & Trades,
#                       Create & Modify Orders, Cancel/Close Orders
# ---------------------------------------------------------------
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ---------------------------------------------------------------
# Trading Configuration
# ---------------------------------------------------------------
# Symbol format must match Kraken WS v2 (e.g. BTC/USD, ETH/USD, SOL/USD)
TRADING_PAIR=BTC/USD

# Size of each order in base asset units
ORDER_SIZE=0.001

# Maximum total base asset held at one time
MAX_POSITION=0.01

# Order book depth to subscribe (10, 25, 100, 500, 1000)
BOOK_DEPTH=25

# ---------------------------------------------------------------
# Strategy Parameters
# ---------------------------------------------------------------
# Combined imbalance score threshold to trigger a signal (0.0–1.0)
IMBALANCE_THRESHOLD=0.25

# Minimum signal confidence to act (0.0–1.0)
MIN_CONFIDENCE=0.55

# Maximum bid-ask spread in basis points before skipping (e.g. 15 = 0.15%)
MAX_SPREAD_BPS=15.0

# ---------------------------------------------------------------
# Risk Controls
# ---------------------------------------------------------------
# Dead-man's switch: cancel all open orders if not refreshed in N*2 seconds
# Set to 0 to disable (not recommended in production)
DEAD_MANS_SWITCH_SECONDS=60

# DRY_RUN=true  → connect to WS, receive data, compute signals, but DO NOT send orders
# DRY_RUN=false → live trading (set only after thorough testing)
DRY_RUN=true

# ---------------------------------------------------------------
# Trailing Stop / Take Profit
# ---------------------------------------------------------------
# Maximum loss in USD before hard stop loss triggers
STOP_LOSS_USD=30.0

# Take profit as a multiple of stop loss (3.0 = 3:1 risk-reward = $90 profit target)
RISK_REWARD_RATIO=3.0

# Each trail step = this fraction of the total TP range (0.25 = 25% = $22.50 per step)
# Milestone progression for a BUY at entry E:
#   0 → 25%  of TP ($22.50): SL moves to entry (break-even)
#   25% → 50% of TP ($22.50): SL moves to E + $22.50
#   50% → 75% of TP ($22.50): SL moves to E + $45.00
#   75% → 100% of TP        : TP hit, exit with $90
TRAIL_STEP_PCT=0.25

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
LOG_LEVEL=INFO
