          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 20,
      "title": "Monthly Cost Trend",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "color": {
            "fixedColor": "#FF9830",
            "mode": "fixed"
          }
        }
      },
      "targets": [
        {
          "expr": "aws_cost_month_total_usd",
          "legendFormat": "Month spend"
        }
      ]
    },
    {
      "id": 21,
      "title": "Cost by AWS Service This Month",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      },
      "targets": [
        {
          "expr": "topk(10, aws_cost_service_usd > 0)",
          "legendFormat": "{{service}}"
        }
