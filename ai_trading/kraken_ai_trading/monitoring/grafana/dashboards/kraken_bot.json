    {
      "id": 19,
      "title": "EC2 + EBS This Month",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {
            "fixedColor": "#5794F2",
            "mode": "fixed"
          }
        }
      },
      "targets": [
        {
          "expr": "aws_cost_ec2_usd",
          "legendFormat": "EC2+EBS"
        }
      ],
      "options": {
